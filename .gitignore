# dependencies — reinstall with `npm install`
node_modules
dist

# throwaway debug build produced by build/mkdebug.py
__debug.html

# tooling scratch
.claude-flow
*.local
.DS_Store
Thumbs.db
__pycache__/

# editor/tool state (only launch.json is kept)
.claude/*
!.claude/launch.json

# hand review output. These are renders, they are megabytes, and one of them is
# a side-by-side with a reference model that is deliberately not in this repo --
# so the whole directory stays local. tools/hand-review.mjs and
# tools/hand-sheets.mjs write it; nothing reads it but a human.
docs/hand-review/

# v25 UI review output. Before/after screenshots at seven viewports across
# every meta screen, plus the audit JSON behind them. Megabytes of PNG that
# only a human reads, and none of it belongs in a release -- the game is one
# self-contained HTML file and this is not part of it.
docs/ui-review/
